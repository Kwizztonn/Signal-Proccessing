                auto_vmax = float(np.max(finite)) if finite.size else 1.0
                vmin = float(color_cfg["vmin"]) if color_cfg["manual_clim"] else auto_vmin
                vmax = float(color_cfg["vmax"]) if color_cfg["manual_clim"] else auto_vmax
