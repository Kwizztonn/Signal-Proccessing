            "mode": self.cmb_mode.currentText(),
            "signal_kind": signal_kind,
            "signal_name": self._signal_name(),

            "use_filtered": (self.cmb_data_source.currentText() == "Filtered") if signal_kind == "acc" and not self._is_waterfall_mode() else False,
